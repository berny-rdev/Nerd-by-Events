# Copy to `.env` and fill in. Restart the dev server after editing —
# EXPO_PUBLIC_* values are inlined at bundle time, not read at runtime.
#
# There are no API keys in this file any more. Every third-party key the app
# needs now lives on the Cloudflare Worker in ./proxy as a secret, and the app
# knows only the Worker's URL. See proxy/README.md for the secrets it needs.

# Deployed URL of the worker in ./proxy (no trailing slash).
# Every event source and both model routes go through it.
EXPO_PUBLIC_EVENTS_PROXY_URL=

# Prefills the city field on first launch.
EXPO_PUBLIC_DEFAULT_CITY=New York

# --- dev tooling only, never read by the app ---------------------------------
# Used by scripts/score.ts, which calls Anthropic directly rather than through
# the Worker. Note the deliberately missing EXPO_PUBLIC_ prefix: Expo inlines
# every EXPO_PUBLIC_* value into the app bundle, so a key with that prefix would
# ship to every device that installs the app.
ANTHROPIC_API_KEY=
