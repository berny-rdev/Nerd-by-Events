# Copy to `.env` and fill in. Restart the dev server after editing —
# EXPO_PUBLIC_* values are inlined at bundle time, not read at runtime.
#
# Anything with the EXPO_PUBLIC_ prefix ships inside the JS bundle and can be
# extracted from a built app. Only put read-only, revocable keys here.

# https://developer.ticketmaster.com/  -> Consumer Key
EXPO_PUBLIC_TICKETMASTER_API_KEY=

# https://seatgeek.com/account/develop -> Client ID
EXPO_PUBLIC_SEATGEEK_CLIENT_ID=

# Deployed URL of the worker in ./proxy (no trailing slash).
# The SerpAPI key itself lives on the worker, never here — it's billed per
# search, so shipping it in the bundle would be handing out your credits.
EXPO_PUBLIC_EVENTS_PROXY_URL=

# Prefills the city field on first launch.
EXPO_PUBLIC_DEFAULT_CITY=New York
