# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# NOTE: the default Expo .gitignore only covers `.env*.local`, which would let
# a real `.env` get committed. This repo keeps its keys in `.env`, so:
.env
.env*.local
!.env.example

# cloudflare worker
proxy/.wrangler/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
